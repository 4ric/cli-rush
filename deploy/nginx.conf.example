limit_req_zone $binary_remote_addr zone=cli_rush_login:10m rate=5r/m;

server {
    listen 443 ssl http2;
    server_name cli-rush.example.com;

    # Configure your existing certificate directives here.
    # Keep this hostname identical to CLI_RUSH_PUBLIC_ORIGIN. Reject aliases
    # instead of forwarding an attacker-controlled Host to the application.
    if ($host != "cli-rush.example.com") { return 444; }
    client_max_body_size 1m;

    location = /login {
        limit_req zone=cli_rush_login burst=3 nodelay;
        proxy_pass http://127.0.0.1:3080;
        proxy_set_header Host cli-rush.example.com;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host cli-rush.example.com;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
    }

    location / {
        proxy_pass http://127.0.0.1:3080;
        proxy_http_version 1.1;
        proxy_set_header Host cli-rush.example.com;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host cli-rush.example.com;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
}
