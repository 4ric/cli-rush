{
  "name": "cli-rush-arena",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "vite",
    "build": "bash scripts/build-verified.sh",
    "start": "vinext start",
    "start:docker": "node server/auth-server.mjs",
    "init:secrets": "node scripts/init-secrets.mjs",
    "package:docker": "node scripts/package-docker.mjs",
    "scan:sensitive": "node scripts/scan-sensitive-content.mjs",
    "qa:browser": "node scripts/browser-qa.mjs",
    "qa:interaction": "node scripts/interaction-qa.mjs",
    "qa:lighthouse": "node scripts/lighthouse-qa.mjs",
    "qa:responsive": "node scripts/responsive-audit.mjs",
    "qa:soak": "node scripts/terminal-soak-qa.mjs",
    "qa:webkit": "node scripts/webkit-qa.mjs",
    "qa:serve:production": "node scripts/production-qa-server.mjs",
    "generate:coverage": "node scripts/generate-command-coverage.ts",
    "test": "npm run test:unit && npm run validate:lab-evidence && npm run build && npm run test:privacy && npm run test:auth && npm run test:docker && node --test tests/rendered-html.test.mjs",
    "test:unit": "node --test tests/engine/*.test.ts",
    "test:auth": "node --test tests/server/auth-server.test.mjs",
    "test:docker": "node --test tests/docker-package.test.mjs",
    "test:privacy": "node --test tests/security/*.test.mjs && npm run scan:sensitive",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "validate:lab-evidence": "node scripts/validate-lab-evidence.mjs validation/lab-evidence.json",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "@vitejs/plugin-rsc": "0.5.26",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-server-dom-webpack": "19.2.6",
    "vinext": "0.0.50",
    "vite": "8.1.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.44.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "lighthouse": "^13.4.0",
    "playwright": "1.61.1",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "wrangler": "4.110.0"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.10"
    }
  },
  "type": "module",
  "displayName": "CLI RUSH: Network Command Arena"
}
